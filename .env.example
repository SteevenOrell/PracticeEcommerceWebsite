# Copy to .env.local and fill in. Never commit real values.
# All VITE_* variables are embedded in the public JS bundle — do not put secrets here.

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Legacy UI-only admin gating. Prefer a Firebase custom claim (admin: true) and leave this empty.
VITE_ADMIN_EMAIL=

# Optional: override the REST API base URL (defaults to the demo MockAPI project)
VITE_API_BASE_URL=
