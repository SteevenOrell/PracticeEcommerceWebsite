# Copy to .env.local and fill in. Never commit real values.
# All VITE_* variables are embedded in the public JS bundle — do not put secrets here.

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: "true" connects to the local Firebase Emulator Suite (npm run emulators)
VITE_USE_FIREBASE_EMULATOR=

# Admin access is a Firebase custom claim, granted with `npm run firebase:set-admin -- <email>`.
# The Admin SDK scripts read a service-account key from GOOGLE_APPLICATION_CREDENTIALS
# (a path OUTSIDE this repo). That key is a real secret: never commit it, never prefix it with VITE_.
